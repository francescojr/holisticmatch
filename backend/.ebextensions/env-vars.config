# Environment Variables for Elastic Beanstalk
# These variables are set in the EB environment via GitHub Actions
# The values come from GitHub Secrets and are passed during deployment

option_settings:
  aws:elasticbeanstalk:application:environment:
    # API Keys (sourced from GitHub Secrets in CI/CD)
    # Note: Production values are set via GitHub Actions deployment
    # OPENAI_API_KEY: set via CI/CD (GitHub Secrets)
    # RESEND_API_KEY: set via CI/CD (GitHub Secrets)
    # SECRET_KEY: set via CI/CD (GitHub Secrets)
    # DATABASE_URL: set via CI/CD (GitHub Secrets)
    
    # These are safe to hardcode or can be set via EB console
    DJANGO_SETTINGS_MODULE: "config.settings"
    PYTHONUNBUFFERED: "1"
